# -*- coding: utf-8 -*-
"""
============================================
 上海物理等级考智能命题助手（本地版）
============================================

这是"网页版命题工具"的本地版本（Streamlit）。
用户描述一个情境，或上传题目背景资料（图片/PDF/Word/文本），
AI 根据这些内容命制上海物理等级考风格的试题，并编译成 PDF。

运行方法：
    streamlit run app.py
"""

# ---------- 导入需要的库 ----------
import streamlit as st
import anthropic
import subprocess
import os
import io
import time
import base64
import json
import urllib.request

# PDF解析库
try:
    from pypdf import PdfReader
except ImportError:
    PdfReader = None

# Word解析库
try:
    from docx import Document
except ImportError:
    Document = None

# ---------- 设置网页基本信息 ----------
st.set_page_config(
    page_title="上海物理等级考命题助手",
    page_icon="📐",
    layout="wide"
)

# ---------- 命题规范提示词（核心！把命题经验写进去） ----------
命题规范 = """
你是上海物理等级考命题专家。用户会给你一个情境描述，或上传题目背景资料。
请根据用户提供的情境/资料命制试题，严格遵循以下规范：

【情境处理】
1. 如果用户提供了情境描述或背景资料，基于它命制试题
2. 如果用户上传的是现成题目/教材内容，不要照搬，将其改编成上海等级考风格的新题
3. 从用户给的情境中挖掘物理考点，用情境承载物理知识

【试卷格式】
1. 大题标题居中，格式如"一、×××（18分）"
2. 每道大题3-5个小题，严格由易到难排列
3. 卷首需包含：考试时间60分钟、满分100分、特别提示（多选规则、g取9.8）

【命题原则】
1. 每个大题内部考点绝不重复，各小题考察不同知识维度
2. 高度情境化：用真实生活/科技/自然现象场景承载物理知识，避免机械计算
3. 设置情境过渡：出完较易的题后扩展情境（但不脱离主线），命制思维量更大的题
4. 适当设计概念辨析题（"你同意/不同意，理由是__"）
5. 思维难度大于计算难度，多出判断说理、方案论证题
6. 从课本挖掘物理精华，可用中国科技成就、古代科技、物理学史作素材
7. 题型多样化：单选、多选、填空、计算、简答、论证、作图混合

【难度】
- 保持上海物理等级考的标准命题难度（参考近年真题水平）
- 每道大题内小题严格由易到难，前易后难

【题目配图要求 - 物理示意图】
1. 题干需要情境图/受力图/电路图/图像题配图时，在题干中用文字精确描述图的构成
   （元素、位置、箭头方向、标注符号），格式如："图1为……（画出……）"
2. 示意图遵循真题黑白线稿风格：物体用规则矩形/圆/三角、细线描边，力/速度用实心小箭头，
   虚线表示辅助线/法线，坐标轴带箭头并标注单位（t/s、v/(m·s⁻¹)），电路用规范符号
   （电源 -|、电阻 ▭、电流表/电压表圈内 A/V）
3. 尽量在HTML中用一个<svg>或描述性文本占位呈现示意图，保持整套卷风格一致
4. 配图采用两阶段工作流：阶段一先用文生图生成草图（保证要素齐全、结构正确）；
   阶段二再用图编辑模型局部精修（①箭头从质心/作用点正确引出且方向符合物理规律，
   ②标注文字中文宋体、物理量符号斜体、单位正体、字号统一并纠错别字，
   ③线条粗细统一为细线、去彩色去填充），确保物理正确性与整套卷风格一致
5. AI生成的示意图是示意性草稿，箭头方向、标注文字、线条粗细可能不完全准确；
   题干文字必须精确描述图的构成（元素/位置/箭头方向/标注符号），
   便于使用者按实际物理情境核对调整后使用

【输出格式 - 非常重要】
输出一个完整的、可直接在浏览器打开的HTML文档，要求：
1. 用 <!DOCTYPE html> 开头，含 <html><head><body>
2. 在<head>中加入 MathJax 公式渲染库：
   <script src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-chtml.js"><\/script>
3. 物理公式用 \\(...\\) 或 \\[...\\] 表示（MathJax语法）
4. 试卷正文、参考答案（另起一页用分页符）、双向细目表（表格）三部分
5. 双向细目表用<table>表格：列包含 大题/小题号/考点/教材来源/难度/分值
6. 添加打印样式：@media print { .page-break { page-break-before: always; } }
7. 只输出HTML代码本身，不要用代码块包裹，不要输出任何其他文字
"""

# ---------- DeepSeek 调用函数（OpenAI兼容格式） ----------
def call_deepseek(api_key, system, user_text, model="deepseek-chat"):
    """调用DeepSeek API（OpenAI兼容），返回文本内容"""
    url = "https://api.deepseek.com/v1/chat/completions"
    payload = {
        "model": model,
        "messages": [
            {"role": "system", "content": system},
            {"role": "user", "content": user_text}
        ],
        "max_tokens": 12000,
        "stream": False
    }
    req = urllib.request.Request(
        url,
        data=json.dumps(payload).encode("utf-8"),
        headers={
            "Content-Type": "application/json",
            "Authorization": f"Bearer {api_key}"
        }
    )
    with urllib.request.urlopen(req, timeout=180) as resp:
        data = json.loads(resp.read().decode("utf-8"))
    return data["choices"][0]["message"]["content"]

# ---------- 侧边栏：命题设置 ----------
st.sidebar.title("⚙️ 命题设置")
st.sidebar.caption("描述一个情境，或上传题目背景资料")

# AI提供商选择
AI提供商 = st.sidebar.radio(
    "选择AI提供商",
    ["Claude", "DeepSeek"],
    help="Claude：视觉强、中文好；DeepSeek：价格便宜、国内直连"
)

# API Key（根据选择的AI显示对应提示）
if AI提供商 == "Claude":
    key_label = "🔑 Claude API密钥"
    key_help = "在 https://console.anthropic.com 注册获取"
else:
    key_label = "🔑 DeepSeek API密钥"
    key_help = "在 https://platform.deepseek.com 注册获取"

api_key = st.sidebar.text_input(key_label, type="password", help=key_help)

# 情境描述
st.sidebar.subheader("💬 情境描述")
描述 = st.sidebar.text_area(
    "描述一个情境 / 想考的知识点",
    placeholder="例如：我想考带电粒子在磁场中的运动，请结合极光这个自然现象命制一道大题。\n\n或描述一个情景：\n'复兴号动车组从启动到进站的完整旅程'",
    height=120
)

# 文件上传
st.sidebar.subheader("📎 或上传背景资料")
上传文件 = st.sidebar.file_uploader(
    "图片 / PDF / Word / 文本",
    type=["pdf", "docx", "txt", "md", "jpg", "jpeg", "png", "gif", "webp"],
    help="图片会直接发给AI理解；PDF/Word/文本会自动提取内容"
)

# 题型选择
st.sidebar.subheader("📝 题型")
题型 = st.sidebar.multiselect(
    "选择题型（可多选）",
    ["单选", "多选", "填空", "计算", "论证/简答"],
    default=["多选", "计算"]
)

# 生成规模
规模 = st.sidebar.radio(
    "生成规模",
    ["1道大题（3-5小题）", "完整试卷（6道大题）"]
)

# ---------- 主区域 ----------
st.title("📐 上海物理等级考智能命题助手")
st.caption("描述情境或上传资料，AI自动命制符合等级考风格的试卷PDF")

st.warning(
    "⚠️ **配图说明**：AI 生成的物理示意图（受力图/电路图/图像题等）为**示意性草稿**，"
    "箭头方向、标注文字、线条粗细可能不完全准确，**请根据实际物理情境核对调整**后再使用。"
    "出题配图可参考本文件夹 `绘图参考/drawing_prompts.md`（20套按考点分类的绘图模板 + "
    "两阶段工作流：先文生图出草图、再图编辑精修），需要程序化出图可用 `绘图脚本/generate_physics_diagram.py`。"
)

# 显示已上传文件的信息
if 上传文件:
    st.sidebar.success(f"✅ 已上传：{上传文件.name}")

# ---------- 文件处理函数 ----------
def 处理文件(上传文件):
    """根据文件类型提取内容，返回 (图片数据或None, 提取的文本)"""
    if 上传文件 is None:
        return None, ""

    name = 上传文件.name
    ext = name.split(".")[-1].lower() if "." in name else ""
    file_bytes = 上传文件.getvalue()

    # 图片 → 转base64给AI看
    if ext in ["jpg", "jpeg", "png", "gif", "webp"]:
        media_type = 上传文件.type or ("image/jpeg" if ext in ["jpg","jpeg"] else "image/png")
        b64 = base64.b64encode(file_bytes).decode("utf-8")
        return {"media_type": media_type, "data": b64}, ""

    # PDF → 用pypdf提取文本
    elif ext == "pdf" and PdfReader:
        try:
            reader = PdfReader(io.BytesIO(file_bytes))
            text = ""
            for page in reader.pages[:10]:  # 最多读10页
                text += (page.extract_text() or "") + "\n"
            return None, text
        except Exception as e:
            return None, f"[PDF解析失败：{e}]"

    # Word → 用python-docx提取文本
    elif ext == "docx" and Document:
        try:
            doc = Document(io.BytesIO(file_bytes))
            text = "\n".join(p.text for p in doc.paragraphs if p.text.strip())
            return None, text
        except Exception as e:
            return None, f"[Word解析失败：{e}]"

    # 纯文本
    elif ext in ["txt", "md"]:
        try:
            return None, file_bytes.decode("utf-8", errors="ignore")
        except:
            return None, ""

    else:
        return None, "[暂不支持的格式，请用图片/PDF/Word/文本]"

# ---------- 生成按钮 ----------
可以生成 = api_key and (描述 or 上传文件)
if st.button("🚀 生成试卷", disabled=not 可以生成):
    # 处理文件（在点击生成时才解析，避免阻塞页面）
    with st.spinner("📂 正在解析资料..."):
        图片数据, 提取文本 = 处理文件(上传文件)

    # 校验
    if not 描述 and not 提取文本 and not 图片数据:
        st.error("❌ 请描述一个情境，或上传题目背景资料")
        st.stop()

    # 组装文字（DeepSeek和Claude都需要的纯文本部分）
    user_text = ""
    if 描述:
        user_text += f"【情境描述】\n{描述}\n\n"
    if 提取文本:
        user_text += f"【用户上传资料的文字内容】\n{提取文本[:6000]}\n\n"

    user_text += f"【命题要求】\n请根据以上情境/资料，命制上海物理等级考风格的物理试题。\n"
    user_text += f"题型要求：{('、'.join(题型) if 题型 else '不限')}。\n"
    user_text += f"规模：{'命制1道完整的大题（含3-5个小题）' if '1道' in 规模 else '命制完整6道大题的试卷'}。\n"
    user_text += f"请严格按照命题规范出题。"

    # 调用AI（根据选择分支：Claude / DeepSeek）
    with st.spinner("🤖 AI命题中，通常需要30~60秒..."):
        try:
            if AI提供商 == "Claude":
                # ----- Claude：支持图片视觉 -----
                content_parts = []
                if 图片数据:
                    content_parts.append({
                        "type": "image",
                        "source": {
                            "type": "base64",
                            "media_type": 图片数据["media_type"],
                            "data": 图片数据["data"]
                        }
                    })
                content_parts.append({"type": "text", "text": user_text})

                client = anthropic.Anthropic(api_key=api_key)
                response = client.messages.create(
                    model="claude-sonnet-5",
                    max_tokens=12000,
                    system=命题规范,
                    messages=[{"role": "user", "content": content_parts}]
                )
                html_code = response.content[0].text

            else:
                # ----- DeepSeek：OpenAI兼容，文本模式 -----
                if 图片数据:
                    st.warning("DeepSeek文本模型暂不支持图片理解，已忽略图片，请用文字补充描述。")

                html_code = call_deepseek(api_key, 命题规范, user_text)

            # 去掉可能的代码块包裹
            html_code = html_code.replace("```html", "").replace("```", "").strip()
        except Exception as e:
            st.error(f"❌ 生成失败：{e}")
            st.stop()

    # 显示HTML（用组件直接渲染）
    st.success("✅ 生成成功！")

    # 保存为HTML文件并显示
    文件名 = f"试卷_{int(time.time())}"
    html路径 = f"{文件名}.html"
    with open(html路径, "w", encoding="utf-8") as f:
        f.write(html_code)

    # 提供下载
    with open(html路径, "r", encoding="utf-8") as f:
        st.download_button(
            label="📥 下载HTML试卷（浏览器打开后打印为PDF）",
            data=f.read(),
            file_name=f"{文件名}.html",
            mime="text/html"
        )

    # 用st.components直接渲染HTML（含MathJax公式）
    st.markdown("### 📖 预览")
    import streamlit.components.v1 as components
    components.html(html_code, height=700, scrolling=True)

    # 显示HTML源码
    with st.expander("🔧 查看源码（可复制）"):
        st.code(html_code, language="html")

# ---------- 使用说明 ----------
